type tie<class>
// src/http/proxy.tie —— 反向代理 v1（同步有界转发）
// ============================================================
// 归属：路由与策略层（设计稿 §5.2）。站点声明 upstream 时整请求转发：
//   请求重建 = 原请求行 + Host + Content-Length|Transfer-Encoding + Connection: close
//   （跳头收敛；X-Forwarded-*、连接池与事件化异步中继随后续批）；响应**逐字节
//   回传**（对上游以 close 定界，EOF 即响应结束）。
// 传输：有界同步泵——非阻塞 connect（以发送重试探测就绪）、发送重试、接收轮询；
//   截止期限：连接/发送 2s、全程 5s（配置化随之；单线程期内转发窗口短占事件循环，
//   与 0.2 进程模型一并改造）。
// 错误：连接失败/拒绝 → 502；超时 → 504；空响应 → 502（本地小响应，不走上游）。
// 依赖：src/sys/net.tie（门面）、/std/time.tie（单调时钟）。
import "../sys/net.tie"
import "/std/time.tie"

// ---- 模块级全局（文件顶层）----
var g_conn_ms: i64 = 2000;              // 连接/发送阶段截止（毫秒）
var g_total_ms: i64 = 5000;             // 全程截止（毫秒）

namespace proxy {

// 整请求转发：upstream 形如 "ip:port"（或 "localhost:port"，解析为 127.0.0.1）。
// raw = 完整请求缓冲；consumed0 = 头结束；consumed = 体结束；te_chunked = 入站体为分块编码。
// 返回应回给客户端的响应字节（上游响应原样，或本地 502/504）。
pub func forward(upstream: string, raw: table<i64>, consumed0: i64, consumed: i64, te_chunked: i64, host_hdr: string) -> table<i64> {
    var (ip, pport) = parse_ep(upstream)
    if pport <= 0 {
        return err_page(502, "Bad Gateway", "bad upstream address\n")
    }
    var us = net.connect_tcp_nb(ip, pport)
    if us < 0 {
        return err_page(502, "Bad Gateway", "upstream connect failed\n")
    }
    var start = time.mono_ms()
    var line_end = find_crlf_from(raw, 0)
    if line_end < 0 {
        net.close_sock(us)
        return err_page(502, "Bad Gateway", "bad request\n")
    }
// 请求重建（跳头收敛）
    var payload: table<i64> = []
    payload = append_range(payload, raw, 0, line_end + 2)
    var hh = host_hdr
    if str_len(hh) == 0 {
        hh = ip
    }
    var hdrs = "Host: " + hh + "\r\n"
    var blen = consumed - consumed0
    if te_chunked == 1 {
        hdrs = hdrs + "Transfer-Encoding: chunked\r\n"
    } else {
        if blen > 0 {
            hdrs = hdrs + "Content-Length: " + to_string(blen) + "\r\n"
        }
    }
    hdrs = hdrs + "Connection: close\r\n\r\n"
    payload = append_str(payload, hdrs)
    payload = append_range(payload, raw, consumed0, consumed)
    // 发送（非阻塞 connect 由发送重试探测就绪；拒绝等硬错误立即 502）
    var sent: i64 = 0
    var total = len(payload)
    while sent < total {
        var wrc = net.send_bytes(us, slice_from(payload, sent))
        if wrc > 0 {
            sent = sent + wrc
        } else {
            var le = net.last_error()
            if le != 10035 && le != 0 {
                net.close_sock(us)
                return err_page(502, "Bad Gateway", "upstream error\n")
            }
            if time.mono_ms() - start > g_conn_ms {
                net.close_sock(us)
                return err_page(504, "Gateway Timeout", "upstream connect timeout\n")
            }
            net.sleep_ms(2)
        }
    }
    // 接收（逐字节回传；Content-Length 帧界早停；无定界则读至 EOF）
    var out: table<i64> = []
    var want: i64 = -1
    var body_start: i64 = -1
    var done: i64 = 0
    while done == 0 {
        var (chunk, rst) = net.recv_bytes(us, 8192)
        if rst == 1 {
            for x in chunk {
                table_push(out, x)
            }
            if body_start < 0 {
                var hpos = find_hdr_end(out)
                if hpos >= 0 {
                    body_start = hpos + 4
                    want = resp_cl(out, hpos)
                }
            }
            if want >= 0 && body_start >= 0 && len(out) >= body_start + want {
                done = 1
            }
        } else if rst == 0 {
            done = 1
        } else {
            if time.mono_ms() - start > g_total_ms {
                net.close_sock(us)
                return err_page(504, "Gateway Timeout", "upstream response timeout\n")
            }
            net.sleep_ms(2)
        }
    }
    net.close_sock(us)
    if len(out) == 0 {
        return err_page(502, "Bad Gateway", "empty upstream response\n")
    }
    return out
}

// ---------- 内部小工具 ----------

// "ip:port" 解析（须形如字面量；冒号只允许一个且端口为数字）；非法 ("", -1)
func parse_ep(s: string) -> (string, i64) {
    var n = len(s)
    var cpos = -1
    var i: i64 = 0
    while i < n {
        if str_byte(s, i) == 58 {
            if cpos >= 0 {
                return ("", -1)
            }
            cpos = i
        }
        i = i + 1
    }
    if cpos <= 0 || cpos >= n - 1 {
        return ("", -1)
    }
    var ip = substr_range(s, 0, cpos)
    var p: i64 = 0
    var j = cpos + 1
    while j < n {
        var c = str_byte(s, j)
        if c < 48 || c > 57 {
            return ("", -1)
        }
        p = p * 10 + (c - 48)
        if p > 65535 {
            return ("", -1)
        }
        j = j + 1
    }
    if p <= 0 {
        return ("", -1)
    }
    return (ip, p)
}

// 自 from 起首个 CRLF 的 CR 位置（未找到 -1）
func find_crlf_from(b: table<i64>, from: i64) -> i64 {
    var n = len(b)
    var i = from
    while i + 1 < n {
        if b[i] == 13 && b[i + 1] == 10 {
            return i
        }
        i = i + 1
    }
    return -1
}

// 响应头块终止符（\r\n\r\n 的 CR 位置；未到 -1）
func find_hdr_end(b: table<i64>) -> i64 {
    var n = len(b)
    var i: i64 = 0
    while i + 3 < n {
        if b[i] == 13 && b[i + 1] == 10 && b[i + 2] == 13 && b[i + 3] == 10 {
            return i
        }
        i = i + 1
    }
    return -1
}

// 响应头块 [0, hpos) 解析 Content-Length（大小写不敏感；缺失/非法 -1）
func resp_cl(b: table<i64>, hpos: i64) -> i64 {
    var i: i64 = 0
    while i < hpos {
        if ci_match(b, i, "content-length:") {
            var j = i + 15
            while j < hpos && (b[j] == 32 || b[j] == 9) {
                j = j + 1
            }
            var v: i64 = 0
            var digits: i64 = 0
            while j < hpos && b[j] >= 48 && b[j] <= 57 {
                v = v * 10 + (b[j] - 48)
                digits = digits + 1
                if digits > 12 {
                    return -1
                }
                j = j + 1
            }
            if digits == 0 {
                return -1
            }
            return v
        }
        while i < hpos && b[i] != 10 {
            i = i + 1
        }
        i = i + 1
    }
    return -1
}

// ASCII 大小写不敏感匹配（行首用）
func ci_match(b: table<i64>, a: i64, s: string) -> bool {
    var m = len(s)
    var n = len(b)
    if a + m > n {
        return false
    }
    var k: i64 = 0
    while k < m {
        var c = b[a + k]
        if c >= 65 && c <= 90 {
            c = c + 32
        }
        var d = str_byte(s, k)
        if d >= 65 && d <= 90 {
            d = d + 32
        }
        if c != d {
            return false
        }
        k = k + 1
    }
    return true
}

// 追加 src[a..e) 字节（返回合并值；dst 只读——写形参会触发 COW，改动不外传）
func append_range(dst: table<i64>, src: table<i64>, a: i64, e: i64) -> table<i64> {
    var m = dst
    var n = len(src)
    var i = a
    while i < e && i < n {
        table_push(m, src[i])
        i = i + 1
    }
    return m
}

// 追加字符串字节（返回合并值；dst 只读）
func append_str(dst: table<i64>, s: string) -> table<i64> {
    var m = dst
    var n = len(s)
    var i: i64 = 0
    while i < n {
        table_push(m, str_byte(s, i))
        i = i + 1
    }
    return m
}

// 字符串区间 [a, e) → 字符串
func substr_range(s: string, a: i64, e: i64) -> string {
    var sb = string_builder()
    var i = a
    var n = len(s)
    while i < e && i < n {
        sb_append_byte(sb, str_byte(s, i))
        i = i + 1
    }
    return sb_build(sb)
}

// 丢弃前 start 字节（返回新表）
func slice_from(b: table<i64>, start: i64) -> table<i64> {
    var out: table<i64> = []
    var n = len(b)
    var i = start
    while i < n {
        table_push(out, b[i])
        i = i + 1
    }
    return out
}

// 本地错误页（close 语义；不走上游）
func err_page(status_code: i64, reason: string, msg: string) -> table<i64> {
    var head = "HTTP/1.1 " + to_string(status_code) + " " + reason + "\r\n" + "Server: leibnet/0.2.0-dev\r\n" + "Content-Type: text/plain; charset=utf-8\r\n" + "Content-Length: " + to_string(len(msg)) + "\r\n" + "Connection: close\r\n\r\n"
    var out: table<i64> = []
    out = append_str(out, head)
    out = append_str(out, msg)
    return out
}
}
