type tie<class>
// src/http/http1.tie —— HTTP/1.1 协议面（0.2.0：完整批）
// ============================================================
// 纯函数核（可离线测试）：try_respond(buf, doc_root) -> (state, resp, consumed)：
//   state：0 = 请求未完整到达（继续收）；1 = 响应已生成（连接可续）；
//          -1 = 响应已生成且连接须关闭（协议错误 / Connection: close / Expect 直答 等）。
// 连接层（薄状态壳）：feed(conn, data, doc_root) 维护每连接残帧、循环消费完整
//   请求（keep-alive 流水线）、touch 时间戳；sweep(now) 回收空闲连接；
//   note_conn(conn) 登记新连接（覆盖沉默连接）。
// 本批支持：GET/HEAD/OPTIONS；keep-alive（1.1 默认开 / 1.0 默认关，Connection 头
//   覆盖）；查询串剥离 + 百分号解码（解码后防穿越）；请求体定界 = Content-Length
//   消费（上限 413）与 chunked 解码（trailer 跳过；畸形 400；非 chunked TE 501）；
//   走私防护（TE+CL 并存 400；重复 CL 400）；Expect 不等待（终态直答 + 关闭）；
//   非 GET/HEAD/OPTIONS ⇒ 405 + Allow；头部超限 431；Date/Server 头。
// 限额（set_limits 注入）：max_header / max_body / keepalive_ms（0 = 不回收）。
// 不支持（记档）：100-continue 真等待、range、gzip、写缓冲 —— 后续批。
// 依赖：/std/fs.tie（读文件字节）、/std/time.tie（单调时钟）、/std/datetime.tie（Date）。
import "/std/fs.tie" as fs
import "/std/time.tie"
import "/std/datetime.tie"

// ---- 模块级全局（文件顶层）----
var g_hconns: table<i64> = [];          // 活跃 http 连接（残帧表）
var g_hleft: table<table<i64>> = [];    // 每连接残帧缓冲
var g_hlast: table<i64> = [];           // 每连接最近活动（单调毫秒，与 g_hconns 对齐）
var g_req_ver10: i64 = 0;               // parse_reqline 版本输出槽（1 = HTTP/1.0）
var g_max_header: i64 = 16384;          // 请求头/未解析缓冲上限（超出 431）
var g_max_body: i64 = 1048576;          // 请求体上限（超出 413）
var g_ka_ms: i64 = 60000;               // keep-alive 空闲回收毫秒（0 = 不回收）
var g_closing: table<i64> = [];         // 排空关闭（linger）中的连接
var g_cldl: table<i64> = [];            // 对应 linger 截止时刻（单调毫秒）
var g_linger_ms: i64 = 2000;            // 排空关闭 linger 上限（毫秒）
var g_req_host: string = "";            // scan_headers 主机头输出槽（去端口）
var g_site_hosts: table<string> = [];   // 虚拟主机模式（"" = 默认站点）
var g_site_roots: table<string> = [];   // 对应文档根

namespace http1 {

// ---------- 运行时限额注入 ----------

// 数据面限额注入（main 启动时从 conf 读入；判据单一来源在 conf）。
pub func set_limits(max_header: i64, max_body: i64, keepalive_ms: i64) -> i64 {
    g_max_header = max_header
    g_max_body = max_body
    g_ka_ms = keepalive_ms
    return 0
}

// 虚拟主机表注入（main 启动时从 conf 读入；空表 = 单根回退 server.doc_root）。
// host 模式：精确匹配或 "*.后缀" 通配（大小写不敏感）；"" = 默认站点（首个生效）。
pub func set_sites(hosts: table<string>, roots: table<string>) -> i64 {
    g_site_hosts = hosts
    g_site_roots = roots
    return 0
}

// ---------- 字节/字符串小工具 ----------

// 字节区间 [a, e) → 字符串（ASCII）
func bytes_to_str(b: table<i64>, a: i64, e: i64) -> string {
    var sb = string_builder()
    var i = a
    var n = len(b)
    while i < e && i < n {
        sb_append_byte(sb, b[i])
        i = i + 1
    }
    return sb_build(sb)
}

// 字符串 → 字节表
func str_to_bytes(s: string) -> table<i64> {
    var out: table<i64> = []
    var i: i64 = 0
    var n = len(s)
    while i < n {
        table_push(out, str_byte(s, i))
        i = i + 1
    }
    return out
}

// 字节区间 [a, e) → 字符串（string 输入；查询串剥离用）
func substr_bytes(s: string, a: i64, e: i64) -> string {
    var sb = string_builder()
    var i = a
    var n = len(s)
    while i < e && i < n {
        sb_append_byte(sb, str_byte(s, i))
        i = i + 1
    }
    return sb_build(sb)
}

// 单字节查找（未找到 -1；避免与 tiec interp 链的 find_char 撞名）
func find_byte(s: string, c: i64) -> i64 {
    var n = len(s)
    var i: i64 = 0
    while i < n {
        if str_byte(s, i) == c {
            return i
        }
        i = i + 1
    }
    return -1
}

// 4 字节序列 [c0,c1,c2,c3] 首匹配起点；未找到 -1（头结束 \r\n\r\n 定位用）
func find_seq4(b: table<i64>, c0: i64, c1: i64, c2: i64, c3: i64) -> i64 {
    var n = len(b)
    var i: i64 = 0
    while i + 3 < n {
        if b[i] == c0 && b[i + 1] == c1 && b[i + 2] == c2 && b[i + 3] == c3 {
            return i
        }
        i = i + 1
    }
    return -1
}

// 自 from 起首个 CRLF 的 CR 位置（未找到 -1）
func find_crlf(b: table<i64>, from: i64) -> i64 {
    var n = len(b)
    var i = from
    while i + 1 < n {
        if b[i] == 13 && b[i + 1] == 10 {
            return i
        }
        i = i + 1
    }
    return -1
}

// ASCII 小写折叠
func fold_lc(c: i64) -> i64 {
    if c >= 65 && c <= 90 {
        return c + 32
    }
    return c
}

// buf[a..) 处是否（大小写不敏感）匹配 ASCII 串
func match_ci(b: table<i64>, a: i64, s: string) -> bool {
    var n = len(b)
    var m = len(s)
    if a + m > n {
        return false
    }
    var i: i64 = 0
    while i < m {
        if fold_lc(b[a + i]) != fold_lc(str_byte(s, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

// 行 [ls, le) 中是否含（大小写不敏感）子串
func value_has_ci(b: table<i64>, ls: i64, le: i64, s: string) -> bool {
    var m = len(s)
    if m == 0 || le - ls < m {
        return false
    }
    var i = ls
    while i + m <= le {
        var k: i64 = 0
        var hit: i64 = 1
        while k < m {
            if fold_lc(b[i + k]) != fold_lc(str_byte(s, k)) {
                hit = 0
                k = m
            } else {
                k = k + 1
            }
        }
        if hit == 1 {
            return true
        }
        i = i + 1
    }
    return false
}

// 十六进制位值（非法 -1）
func hex_val(c: i64) -> i64 {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    return -1
}

// 百分号解码：返回 (状态, 解码串)；0 = OK，-1 = 非法（坏转义/NUL/控制字符）
func pct_decode(s: string) -> (i64, string) {
    var sb = string_builder()
    var n = len(s)
    var i: i64 = 0
    while i < n {
        var c = str_byte(s, i)
        if c == 37 {
            if i + 2 >= n {
                return (-1, "")
            }
            var h1 = hex_val(str_byte(s, i + 1))
            var h2 = hex_val(str_byte(s, i + 2))
            if h1 < 0 || h2 < 0 {
                return (-1, "")
            }
            var v = h1 * 16 + h2
            if v == 0 {
                return (-1, "")
            }
            sb_append_byte(sb, v)
            i = i + 3
        } else {
            if c < 32 || c == 127 {
                return (-1, "")
            }
            sb_append_byte(sb, c)
            i = i + 1
        }
    }
    return (0, sb_build(sb))
}

// 字符串含 ".."（防穿越；须在解码后调用）
func has_dotdot(s: string) -> bool {
    var n = len(s)
    var i: i64 = 0
    while i + 1 < n {
        if str_byte(s, i) == 46 && str_byte(s, i + 1) == 46 {
            return true
        }
        i = i + 1
    }
    return false
}

// 后缀判定
func has_suffix(s: string, suf: string) -> bool {
    var n = len(s)
    var m = len(suf)
    if n < m {
        return false
    }
    var i: i64 = 0
    while i < m {
        if str_byte(s, n - m + i) != str_byte(suf, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// Content-Type 最小映射（逐后缀判断；按设计纪律避免正则）
func content_type_of(path: string) -> string {
    if has_suffix(path, ".html") || has_suffix(path, ".htm") {
        return "text/html; charset=utf-8"
    }
    if has_suffix(path, ".css") {
        return "text/css; charset=utf-8"
    }
    if has_suffix(path, ".js") {
        return "text/javascript; charset=utf-8"
    }
    if has_suffix(path, ".json") {
        return "application/json; charset=utf-8"
    }
    if has_suffix(path, ".txt") || has_suffix(path, ".md") {
        return "text/plain; charset=utf-8"
    }
    if has_suffix(path, ".svg") {
        return "image/svg+xml"
    }
    if has_suffix(path, ".png") {
        return "image/png"
    }
    if has_suffix(path, ".jpg") || has_suffix(path, ".jpeg") {
        return "image/jpeg"
    }
    if has_suffix(path, ".gif") {
        return "image/gif"
    }
    if has_suffix(path, ".ico") {
        return "image/x-icon"
    }
    return "application/octet-stream"
}

// 两位补零
func pad2(n: i64) -> string {
    if n < 10 {
        return "0" + to_string(n)
    }
    return to_string(n)
}

// 四位补零
func pad4(n: i64) -> string {
    if n < 10 {
        return "000" + to_string(n)
    }
    if n < 100 {
        return "00" + to_string(n)
    }
    if n < 1000 {
        return "0" + to_string(n)
    }
    return to_string(n)
}

// HTTP-date（RFC 7231 IMF-fixdate，不含 "Date: " 前缀）："Sun, 12 Oct 2026 07:20:00 GMT"
func http_date_now() -> string {
    var dt = datetime.now()
    var wds = "SunMonTueWedThuFriSat"
    var mns = "JanFebMarAprMayJunJulAugSepOctNovDec"
    var wd = substr_bytes(wds, dt.wday * 3, dt.wday * 3 + 3)
    var mo = substr_bytes(mns, (dt.mo - 1) * 3, (dt.mo - 1) * 3 + 3)
    return wd + ", " + pad2(dt.d) + " " + mo + " " + pad4(dt.y) + " " + pad2(dt.h) + ":" + pad2(dt.mi) + ":" + pad2(dt.s) + " GMT"
}

// ---------- 请求行 / 头部解析 ----------

// 版本判定（请求行行尾 8 字节）：1 = HTTP/1.0；0 = HTTP/1.1；-1 = 非法
func ver10_of(b: table<i64>, e: i64) -> i64 {
    if e < 8 {
        return -1
    }
    if match_ci(b, e - 8, "http/1.0") {
        return 1
    }
    if match_ci(b, e - 8, "http/1.1") {
        return 0
    }
    return -1
}

// 请求行解析：返回 (method_id, path, ok)；method：0=GET 1=HEAD 2=其他 3=OPTIONS；
// 版本写入模块槽 g_req_ver10。ok：0 = 正常，-1 = 畸形。
func parse_reqline(b: table<i64>, hdr_end: i64) -> (i64, string, i64) {
    // 行结束 = 缓冲内首个 CRLF（无头部请求时它就是终止符的 CRLF——不可用 hdr_end 裁剪）
    var e = find_crlf(b, 0)
    if e < 0 {
        return (2, "", -1)
    }
    // 方法
    var m: i64 = 2
    if e >= 4 && b[0] == 71 && b[1] == 69 && b[2] == 84 && b[3] == 32 {
        m = 0
    } else if e >= 5 && b[0] == 72 && b[1] == 69 && b[2] == 65 && b[3] == 68 && b[4] == 32 {
        m = 1
    } else if e >= 8 && b[0] == 79 && b[1] == 80 && b[2] == 84 && b[3] == 73 && b[4] == 79 && b[5] == 78 && b[6] == 83 && b[7] == 32 {
        m = 3
    }
    // 两个空格（method SP path SP version）
    var s1: i64 = -1
    var s2: i64 = -1
    var j: i64 = 0
    while j < e {
        if b[j] == 32 {
            if s1 < 0 {
                s1 = j
            } else {
                s2 = j
                j = e
            }
        }
        j = j + 1
    }
    if s1 < 0 || s2 < 0 {
        return (2, "", -1)
    }
    var v10 = ver10_of(b, e)
    if v10 < 0 {
        return (2, "", -1)
    }
    g_req_ver10 = v10
    return (m, bytes_to_str(b, s1 + 1, s2), 0)
}

// Content-Length 值解析（ls 为行首，"content-length:" 后）；非法 -1
func parse_cl(b: table<i64>, ls: i64, le: i64) -> i64 {
    var i = ls + 15
    while i < le && (b[i] == 32 || b[i] == 9) {
        i = i + 1
    }
    if i >= le {
        return -1
    }
    var v: i64 = 0
    var digits: i64 = 0
    while i < le && b[i] >= 48 && b[i] <= 57 {
        v = v * 10 + (b[i] - 48)
        digits = digits + 1
        if digits > 12 {
            return -1
        }
        i = i + 1
    }
    if digits == 0 {
        return -1
    }
    while i < le {
        if b[i] != 32 && b[i] != 9 {
            return -1
        }
        i = i + 1
    }
    return v
}

// 头部行扫描（start..stop，逐 CRLF 行）：
// 返回 flags = [conn_close, has_te, te_chunked, has_cl, cl_value, cl_count, conn_keepalive, has_expect]
func scan_headers(b: table<i64>, start: i64, stop: i64) -> table<i64> {
    var flags: table<i64> = [0, 0, 0, 0, 0, 0, 0, 0]
    var ls = start
    while ls < stop {
        var le = stop
        var j = ls
        while j < stop {
            if b[j] == 13 {
                le = j
                j = stop
            } else {
                j = j + 1
            }
        }
        if match_ci(b, ls, "transfer-encoding:") {
            flags[1] = 1
            if value_has_ci(b, ls, le, "chunked") {
                flags[2] = 1
            }
        }
        if match_ci(b, ls, "content-length:") {
            flags[3] = 1
            flags[5] = flags[5] + 1
            if flags[5] == 1 {
                flags[4] = parse_cl(b, ls, le)
            }
        }
        if match_ci(b, ls, "connection:") {
            if value_has_ci(b, ls, le, "close") {
                flags[0] = 1
            }
            if value_has_ci(b, ls, le, "keep-alive") {
                flags[6] = 1
            }
        }
        if match_ci(b, ls, "expect:") {
            flags[7] = 1
        }
        if match_ci(b, ls, "host:") {
            if str_len(g_req_host) == 0 {
                g_req_host = host_value_of(b, ls, le)
            }
        }
        ls = le + 2
    }
    return flags
}

// host 头取值：去首尾空白、剥离端口（"[" 开头视为 IPv6 字面量，原样保留）；保留原大小写。
func host_value_of(b: table<i64>, ls: i64, le: i64) -> string {
    var a = ls + 5
    while a < le && (b[a] == 32 || b[a] == 9) {
        a = a + 1
    }
    var e = le
    while e > a && (b[e - 1] == 32 || b[e - 1] == 9) {
        e = e - 1
    }
    var s = bytes_to_str(b, a, e)
    if str_len(s) == 0 {
        return s
    }
    if str_byte(s, 0) == 91 {
        return s
    }
    var cpos = find_byte(s, 58)
    if cpos >= 0 {
        s = substr_bytes(s, 0, cpos)
    }
    return s
}

// host 模式匹配（大小写不敏感）：精确相等，或 "*.后缀"（须有余一标签，裸域不匹配）。
func host_match(host: string, pat: string) -> bool {
    var pn = str_len(pat)
    if pn == 0 {
        return false
    }
    if str_byte(pat, 0) == 42 && pn > 2 && str_byte(pat, 1) == 46 {
        var suf = substr_bytes(pat, 1, pn)
        var hn = str_len(host)
        if hn <= str_len(suf) {
            return false
        }
        return ci_ends_with(host, suf)
    }
    var hn2 = str_len(host)
    if hn2 != pn {
        return false
    }
    var i: i64 = 0
    while i < pn {
        if fold_lc(str_byte(host, i)) != fold_lc(str_byte(pat, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

// host 是否以（大小写不敏感）后缀 suf 结尾
func ci_ends_with(host: string, suf: string) -> bool {
    var hn = str_len(host)
    var sn = str_len(suf)
    if hn < sn {
        return false
    }
    var i: i64 = 0
    while i < sn {
        if fold_lc(str_byte(host, hn - sn + i)) != fold_lc(str_byte(suf, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

// 解析请求主机对应文档根：首个匹配站点；无匹配 → 首个默认站点（"" host）；再无 → fallback。
func pick_root(fallback: string) -> string {
    if len(g_site_hosts) == 0 {
        return fallback
    }
    var def_root: string = ""
    var def_seen: i64 = 0
    var i: i64 = 0
    var n = len(g_site_hosts)
    while i < n {
        var pat = g_site_hosts[i]
        if str_len(pat) == 0 {
            if def_seen == 0 {
                def_root = g_site_roots[i]
                def_seen = 1
            }
        } else {
            if host_match(g_req_host, pat) {
                return g_site_roots[i]
            }
        }
        i = i + 1
    }
    if def_seen == 1 {
        return def_root
    }
    return fallback
}

// ---------- 请求体走查 ----------

// 分块尺寸行 [ls, le)：十六进制数字 + 可选 ";ext"；返回 (状态, 尺寸)：0 = OK，-1 = 畸形
func parse_hex_line(b: table<i64>, ls: i64, le: i64) -> (i64, i64) {
    var i = ls
    var v: i64 = 0
    var digits: i64 = 0
    while i < le {
        var c = b[i]
        if c == 59 {
            i = le
        } else {
            var h = hex_val(c)
            if h < 0 {
                return (-1, 0)
            }
            v = v * 16 + h
            digits = digits + 1
            if digits > 8 {
                return (-1, 0)
            }
            i = i + 1
        }
    }
    if digits == 0 {
        return (-1, 0)
    }
    return (0, v)
}

// 走查分块体：返回 (状态, 结束位置, 累计大小)；
// 状态：0 = 完整；-1 = 未完整；-2 = 畸形；-3 = 超限（> g_max_body）
func chunked_walk(b: table<i64>, pos: i64) -> (i64, i64, i64) {
    var total: i64 = 0
    var p = pos
    while true {
        var e = find_crlf(b, p)
        if e < 0 {
            return (-1, 0, 0)
        }
        var (ok, sz) = parse_hex_line(b, p, e)
        if ok != 0 {
            return (-2, 0, 0)
        }
        if sz == 0 {
            // 尾段：逐行跳过 trailer，至空行结束
            var t = e + 2
            while true {
                var e2 = find_crlf(b, t)
                if e2 < 0 {
                    return (-1, 0, 0)
                }
                if e2 == t {
                    return (0, t + 2, total)
                }
                t = e2 + 2
            }
        }
        var data_end = e + 2 + sz
        if len(b) < data_end + 2 {
            return (-1, 0, 0)
        }
        if b[data_end] != 13 || b[data_end + 1] != 10 {
            return (-2, 0, 0)
        }
        total = total + sz
        if total > g_max_body {
            return (-3, 0, 0)
        }
        p = data_end + 2
    }
    return (-2, 0, 0)
}

// ---------- 响应构造 ----------

// 组装响应（extra = 附加头行，如 Allow；须自带 CRLF 或以空串传入）
func build_response(status_code: i64, reason: string, ctype: string, body: table<i64>, head_only: i64, close_flag: i64, extra: string) -> table<i64> {
    var conn_str = "keep-alive"
    if close_flag == 1 {
        conn_str = "close"
    }
    var head = "HTTP/1.1 " + to_string(status_code) + " " + reason + "\r\n" + "Server: leibnet/0.2.0-dev\r\n" + "Date: " + http_date_now() + "\r\n" + "Content-Type: " + ctype + "\r\n" + "Content-Length: " + to_string(len(body)) + "\r\n" + "Connection: " + conn_str + "\r\n" + extra + "\r\n"
    var out = str_to_bytes(head)
    if head_only == 0 {
        for x in body {
            table_push(out, x)
        }
    }
    return out
}

// 错误响应小包装（text/plain）
func err_resp(status_code: i64, reason: string, msg: string, head_only: i64, close_flag: i64) -> table<i64> {
    return build_response(status_code, reason, "text/plain; charset=utf-8", str_to_bytes(msg), head_only, close_flag, "")
}

// 关闭标志 → 状态（-1 = 响应后关闭；1 = 保持）
func resp_state(close_flag: i64) -> i64 {
    if close_flag == 1 {
        return -1
    }
    return 1
}

// ---------- 纯函数核 ----------

// 主入口（状态约定见文件头）
pub func try_respond(buf: table<i64>, doc_root: string) -> (i64, table<i64>, i64) {
    var empty: table<i64> = []
    var hdr_end = find_seq4(buf, 13, 10, 13, 10)
    if hdr_end < 0 {
        return (0, empty, 0)
    }
    var consumed0 = hdr_end + 4
    var (method, path, pok) = parse_reqline(buf, hdr_end)
    if pok != 0 {
        return (-1, err_resp(400, "Bad Request", "bad request\n", 0, 1), consumed0)
    }
    // 完整头但超限 ⇒ 431（与 feed 的「未完整超限」守卫互补）
    if consumed0 > g_max_header {
        return (-1, err_resp(431, "Request Header Fields Too Large", "header too large\n", 0, 1), consumed0)
    }
    var ver10 = g_req_ver10
    g_req_host = ""
    var flags = scan_headers(buf, 0, hdr_end)
    // HTTP/1.1 必须携带 Host（RFC 7230；1.0 无 Host 由默认站点/回落承接）
    if ver10 == 0 && str_len(g_req_host) == 0 {
        return (-1, err_resp(400, "Bad Request", "missing host\n", 0, 1), consumed0)
    }
    // 走私防护组合：TE 与 CL 并存 / 重复 CL 一律拒绝
    if flags[1] == 1 && flags[3] == 1 {
        return (-1, err_resp(400, "Bad Request", "transfer-encoding with content-length\n", 0, 1), consumed0)
    }
    if flags[5] > 1 {
        return (-1, err_resp(400, "Bad Request", "duplicate content-length\n", 0, 1), consumed0)
    }
    // 请求体定界
    var body_end = consumed0
    var force_close: i64 = 0
    if flags[1] == 1 {
        if flags[2] == 0 {
            return (-1, err_resp(501, "Not Implemented", "unsupported transfer coding\n", 0, 1), consumed0)
        }
        var (cs, cend, ctot) = chunked_walk(buf, consumed0)
        if cs == 0 {
            body_end = cend
        } else if cs == -1 {
            if flags[7] == 1 {
                force_close = 1
            } else {
                return (0, empty, 0)
            }
        } else if cs == -3 {
            return (-1, err_resp(413, "Payload Too Large", "body too large\n", 0, 1), consumed0)
        } else {
            return (-1, err_resp(400, "Bad Request", "bad chunked body\n", 0, 1), consumed0)
        }
    } else if flags[3] == 1 {
        if flags[4] < 0 {
            return (-1, err_resp(400, "Bad Request", "bad content-length\n", 0, 1), consumed0)
        }
        if flags[4] > g_max_body {
            return (-1, err_resp(413, "Payload Too Large", "body too large\n", 0, 1), consumed0)
        }
        var need = consumed0 + flags[4]
        if len(buf) < need {
            if flags[7] == 1 {
                force_close = 1
            } else {
                return (0, empty, 0)
            }
        } else {
            body_end = need
        }
    }
    var consumed = body_end
    // 连接语义：1.1 默认保持 / 1.0 默认关闭；Connection 头覆盖；Expect 直答后关闭
    var keep: i64 = 1
    if ver10 == 1 {
        keep = flags[6]
    }
    if flags[0] == 1 {
        keep = 0
    }
    if force_close == 1 {
        keep = 0
    }
    var head_only: i64 = 0
    if method == 1 {
        head_only = 1
    }
    var close_flag: i64 = 0
    if keep == 0 {
        close_flag = 1
    }
    if method == 3 {
        return (resp_state(close_flag), build_response(200, "OK", "text/plain; charset=utf-8", str_to_bytes(""), 0, close_flag, "Allow: GET, HEAD, OPTIONS\r\n"), consumed)
    }
    if method == 2 {
        return (resp_state(close_flag), build_response(405, "Method Not Allowed", "text/plain; charset=utf-8", str_to_bytes("method not allowed\n"), 0, close_flag, "Allow: GET, HEAD, OPTIONS\r\n"), consumed)
    }
    // 路径：剥离查询串 → 百分号解码 → 校验（解码后防穿越）
    var pure = path
    var q = find_byte(path, 63)
    if q >= 0 {
        pure = substr_bytes(path, 0, q)
    }
    var (dok, dec) = pct_decode(pure)
    if dok != 0 {
        return (-1, err_resp(400, "Bad Request", "bad percent-encoding\n", head_only, 1), consumed)
    }
    if str_len(dec) == 0 || str_byte(dec, 0) != 47 {
        return (-1, err_resp(400, "Bad Request", "bad path\n", head_only, 1), consumed)
    }
    if has_dotdot(dec) {
        return (-1, err_resp(403, "Forbidden", "forbidden\n", head_only, 1), consumed)
    }
    var fpath = dec
    if str_len(dec) == 1 {
        fpath = "/index.html"
    }
    var root_dir = pick_root(doc_root)
    var full = root_dir + fpath
    if !fs.exists(full) {
        return (resp_state(close_flag), err_resp(404, "Not Found", "not found\n", head_only, close_flag), consumed)
    }
    var body = fs.read_bytes(full)
    return (resp_state(close_flag), build_response(200, "OK", content_type_of(fpath), body, head_only, close_flag, ""), consumed)
}

// ---------- 连接层（残帧 + 流水线消费 + 空闲回收） ----------

// 新连接登记（main 收到 kind=1 时调用；空闲回收据此覆盖未发数据的连接）。
pub func note_conn(conn: i64) -> i64 {
    var t = left_get(conn, time.mono_ms())
    return 0
}

// 处理一段已收字节：消费全部完整请求（keep-alive 流水线），残帧留待续收。
// 返回 (state, resp_bytes)：1 = 发送后保持；-1 = 发送后关闭；0 = 无输出。
pub func feed(conn: i64, data: table<i64>, doc_root: string) -> (i64, table<i64>) {
    var now = time.mono_ms()
    // 排空关闭中的连接：丢弃后续输入（响应已发；等对端 FIN 或 sweep 截止回收）
    if is_closing(conn) {
        var nod: table<i64> = []
        return (0, nod)
    }
    var buf = left_get(conn, now)
    for x in data {
        table_push(buf, x)
    }
    var out: table<i64> = []
    var state: i64 = 0
    var closing: i64 = 0
    while true {
        var (st, resp, consumed) = try_respond(buf, doc_root)
        if st == 0 {
            // 头部未达即超限 ⇒ 431；总缓冲超限 ⇒ 413（防御性）
            var hd = find_seq4(buf, 13, 10, 13, 10)
            if hd < 0 && len(buf) > g_max_header {
                out = merge_bytes(out, err_resp(431, "Request Header Fields Too Large", "header too large\n", 0, 1))
                state = -1
                closing = 1
            } else if len(buf) > g_max_header + g_max_body + 8192 {
                out = merge_bytes(out, err_resp(413, "Payload Too Large", "body too large\n", 0, 1))
                state = -1
                closing = 1
            }
            break
        }
        out = merge_bytes(out, resp)
        if st == -1 {
            state = -1
            closing = 1
            break
        }
        state = 1
        buf = slice_from(buf, consumed)
        if len(buf) == 0 {
            break
        }
    }
    if closing == 1 {
        forget(conn)
        mark_closing(conn, now + g_linger_ms)
    } else {
        left_put(conn, buf, now)
    }
    return (state, out)
}

// 空闲回收：返回应关闭的连接（内部已清状态；主循环负责关套接字）。
pub func sweep(now: i64) -> table<i64> {
    var out: table<i64> = []
    // 排空关闭截止回收（linger 到期）
    var j: i64 = 0
    var m = len(g_closing)
    while j < m {
        var cc = g_closing[j]
        if cc >= 0 {
            if now >= g_cldl[j] {
                g_closing[j] = -1
                table_push(out, cc)
            }
        }
        j = j + 1
    }
    if g_ka_ms <= 0 {
        return out
    }
    var i: i64 = 0
    var n = len(g_hconns)
    while i < n {
        var c = g_hconns[i]
        if c >= 0 {
            var d = now - g_hlast[i]
            if d < 0 {
                d = d + 4294967296
            }
            if d > g_ka_ms {
                g_hconns[i] = -1
                var nb: table<i64> = []
                g_hleft[i] = nb
                g_hlast[i] = 0
                table_push(out, c)
            }
        }
        i = i + 1
    }
    return out
}

// 连接关闭：清残帧状态。
pub func forget(conn: i64) -> i64 {
    var i: i64 = 0
    var n = len(g_hconns)
    while i < n {
        if g_hconns[i] == conn {
            g_hconns[i] = -1
            var nb: table<i64> = []
            g_hleft[i] = nb
            g_hlast[i] = 0
            clear_closing(conn)
            return 0
        }
        i = i + 1
    }
    return -1
}

// 排空关闭标记（linger：带未读数据 closesocket 会触发 RST 丢弃已发响应——先排空再收）
func mark_closing(conn: i64, deadline: i64) -> i64 {
    table_push(g_closing, conn)
    table_push(g_cldl, deadline)
    return 0
}

// 是否处于排空关闭中
func is_closing(conn: i64) -> bool {
    var i: i64 = 0
    var n = len(g_closing)
    while i < n {
        if g_closing[i] == conn {
            return true
        }
        i = i + 1
    }
    return false
}

// 清排空标记
func clear_closing(conn: i64) -> i64 {
    var i: i64 = 0
    var n = len(g_closing)
    while i < n {
        if g_closing[i] == conn {
            g_closing[i] = -1
            return 0
        }
        i = i + 1
    }
    return -1
}

// 内部：合并字节表（返回合并值；dst 保持只读——写形参会触发 COW，改动不外传）
func merge_bytes(dst: table<i64>, src: table<i64>) -> table<i64> {
    var m = dst
    for x in src {
        table_push(m, x)
    }
    return m
}

// 内部：丢弃前 start 字节
func slice_from(b: table<i64>, start: i64) -> table<i64> {
    var out: table<i64> = []
    var n = len(b)
    var i = start
    while i < n {
        table_push(out, b[i])
        i = i + 1
    }
    return out
}

// 内部：残帧缓冲取（无则登记新连接，记活动时刻）
func left_get(conn: i64, now: i64) -> table<i64> {
    var i: i64 = 0
    var n = len(g_hconns)
    while i < n {
        if g_hconns[i] == conn {
            return g_hleft[i]
        }
        i = i + 1
    }
    table_push(g_hconns, conn)
    var nb: table<i64> = []
    table_push(g_hleft, nb)
    table_push(g_hlast, now)
    return nb
}

// 内部：残帧缓冲写回（并刷新活动时刻）
func left_put(conn: i64, buf: table<i64>, now: i64) -> i64 {
    var i: i64 = 0
    var n = len(g_hconns)
    while i < n {
        if g_hconns[i] == conn {
            g_hleft[i] = buf
            g_hlast[i] = now
            return 0
        }
        i = i + 1
    }
    return -1
}
}
