type tie<logic>
// leibnet —— tie 生态接入层服务器
// src/main.tie —— 程序入口与编排（0.1.0 骨架：CLI → 配置装载 → 启动摘要）
// ============================================================
// 模块结构（src/ 下按设计稿 §3 分层解耦，经 import 组合；main 只做编排）：
//   main.tie   入口与编排：CLI → 配置 → 摘要 → 事件引擎启动（服务循环）
//   conf/      控制面·配置：td 装载 + 带出厂默认的访问器（ns conf）
//   —— 已划定归属、随任务落位（0.1.0 路线内）——
//   sys/       平台层：unsafe extern 收敛——net_win.tie（Winsock2/select）与
//              net_posix.tie（epoll）经 #cfg 门面 net.tie 二选一（ns 统一为 net），
//              对外只暴露安全接口（规范 §5.11/§11.5 封装纪律）
//   ev/        事件引擎：拉取式事件表 + 连接管理（event_loop.tie；定时器雏形随 0.2）
//   http/      HTTP/1.1 协议面：请求解析 / 响应构造 / 静态服务（http1.tie）
//   console/   本地控制台：tshell 内嵌雏形（设计稿 §8）
//   obs/       观测：metrics / 结构化日志（横切）
import "./conf/conf.tie"
import "./console/console.tie"
import "./ev/event_loop.tie"
import "./http/http1.tie"
import "./sys/net.tie"
import "/std/args.tie" as args
import "/std/time.tie"

func main() {
    // ---- 阶段 1：CLI 解析 ----
    // --config <path>：显式配置文件；缺省则探测当前目录 leibnet.td
    var explicit = args.value("--config")
    var cfg_path = explicit
    if str_len(cfg_path) == 0 {
        cfg_path = "leibnet.td"
    }
    // ---- 阶段 2：配置装载 ----
    var root = conf.load(cfg_path)
    // 显式指定的配置装载失败 → 报错退出；默认探测未命中 → 纯默认运行
    if root < 0 && str_len(explicit) > 0 {
        println("leibnet: 配置装载失败: " + conf.last_error())
        return
    }
    // ---- 阶段 3：启动摘要 ----
    println("leibnet 0.2.0-dev")
    println("--- 配置摘要 ---")
    print(conf.summary(root))
    // ---- 阶段 4：事件引擎启动（服务循环）----
    var pport = conf.get_int(root, "server.port", 8080)
    var doc_root = conf.get_str(root, "server.doc_root", "www")
    // console（tshell 内嵌雏形）：出厂默认开、仅本地绑定；可配置关闭（设计稿 §8）
    if conf.console_on(root) {
        var cport = conf.console_port(root)
        if console.start(cport) == 0 {
            println("console 就绪: 127.0.0.1:" + to_string(cport))
        } else {
            println("console: 本地监听失败（port=" + to_string(cport) + "，err=" + to_string(net.last_error()) + "）")
        }
    }
    console.set_ctx(root, pport, doc_root)
    // http 数据面限额（判据单一来源在 conf；启动注入）
    http1.set_limits(conf.http_max_header(root), conf.http_max_body(root), conf.http_keepalive_ms(root))
    // 虚拟主机（sites 段 → http1 路由表；无则单根回落 server.doc_root）
    var sc = conf.site_count(root)
    var shosts = table_new_string()
    var sroots = table_new_string()
    var si: i64 = 0
    while si < sc {
        table_push(shosts, conf.site_host(root, si))
        table_push(sroots, conf.site_doc_root(root, si, doc_root))
        si = si + 1
    }
    http1.set_sites(shosts, sroots)
    if sc > 0 {
        println("sites 就绪: " + to_string(sc) + " 个")
    }
    if ev.start(pport) != 0 {
        println("leibnet: 监听失败（port=" + to_string(pport) + "，err=" + to_string(net.last_error()) + "）")
        return
    }
    println("leibnet 正在服务: port=" + to_string(pport) + " doc_root=" + doc_root)
    serve_loop(doc_root)
}

// 服务循环（单线程事件引擎；0.2.0：HTTP/1.1 定界健壮性 + GET/HEAD 静态 + 本地 console 分派）
func serve_loop(doc_root: string) {
    while true {
        var es = ev.poll(50000)
        var i: i64 = 0
        var n = len(es)
        while i + 2 < n {
            var kind = es[i]
            var conn = es[i + 1]
            var extra = es[i + 2]
            if kind == 1 {
                // 新服务连接：登记（空闲回收覆盖沉默连接）
                http1.note_conn(conn)
            } else if kind == 2 {
                if extra > 0 {
                    var data = ev.take(conn)
                    var (st, resp) = http1.feed(conn, data, doc_root)
                    if len(resp) > 0 {
                        ev.send(conn, resp)
                    }
                    // st == -1：排空关闭（linger）——不立即断开，防 RST 丢弃刚发出的响应；
                    // 由 http1 排空余量、对端 FIN 或 sweep 截止回收
                } else {
                    // 对端关闭：清残帧状态
                    http1.forget(conn)
                }
            } else if kind == 3 {
                // 新 console 会话：欢迎语
                ev.send(conn, console.bytes_of(console.greet()))
            } else if kind == 4 {
                if extra > 0 {
                    var cdata = ev.take(conn)
                    var (creq, cresp) = console.feed(conn, cdata)
                    if len(cresp) > 0 {
                        ev.send(conn, console.bytes_of(cresp))
                    }
                    if creq == 1 {
                        console.forget(conn)
                        ev.close_conn(conn)
                    }
                } else {
                    // 对端关闭：清会话状态
                    console.forget(conn)
                }
            }
            i = i + 3
        }
        // keep-alive 空闲回收（每轮一次；50ms 轮询粒度足够）
        var idle = http1.sweep(time.mono_ms())
        for c in idle {
            ev.close_conn(c)
        }
    }
}
