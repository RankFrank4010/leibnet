type tie<class>
// src/conf/conf.tie —— 配置面模块（leibnet 0.1.0）
// ============================================================
// 归属：控制面横切层「td 配置」（设计稿 §3 架构 / §6 配置系统）。
// 设计原则（设计稿 §6）：默认即大多数；一切策略皆配置且全量默认。
// 实现：td（tie:data）解析复用 tie 生态既有配置模块（自包含纯 tie 实现；
// 无别名引用——对齐官方 config_test/driver 用法；别名传播缺陷已于 tiec 修复
// 2026-10-12，本项目不依赖该修复，旧 stage0 亦可编译）；
// 默认值在访问点提供：配置文件缺省或键缺失时返回该项出厂默认。
// 数据流：出厂默认（访问点常量）→ 配置文件（--config / 探测）→（后续）CLI 覆盖。
// 解耦走向：td 解析器提炼入 tlib/std 后（task #8），本模块 import 改库根别名，
// 解除对 tiec 仓路径的引用。
import "../../../tie-repo/tiec/compiler/config.tie" as tdcfg

namespace conf {

// ---------- 装载 ----------

// 装载配置文件；路径为空或文件缺失/解析失败返回 -1（错误见 last_error()）。
pub func load(path: string) -> i64 {
    if str_len(path) == 0 {
        return -1
    }
    return tdcfg.parse_file(path)
}

// 最近一次装载/解析的错误消息（成功时为空串）。
pub func last_error() -> string {
    return tdcfg.err_msg()
}

// ---------- 访问器（带出厂默认；root < 0 时直接返回默认） ----------
// 键存在性用 path_get 判定（返回节点 id，-1 表示缺失）——空串值不会被误当缺失。

pub func get_str(root: i64, path: string, dflt: string) -> string {
    if root < 0 {
        return dflt
    }
    if tdcfg.path_get(root, path) < 0 {
        return dflt
    }
    return tdcfg.get_str(root, path)
}

pub func get_int(root: i64, path: string, dflt: i64) -> i64 {
    if root < 0 {
        return dflt
    }
    if tdcfg.path_get(root, path) < 0 {
        return dflt
    }
    return tdcfg.get_int(root, path)
}

pub func get_bool(root: i64, path: string, dflt: bool) -> bool {
    if root < 0 {
        return dflt
    }
    if tdcfg.path_get(root, path) < 0 {
        return dflt
    }
    return tdcfg.get_bool(root, path)
}

// ---------- console（本地控制面；出厂默认 = 设计稿 §6.2 / §8，判据单一来源） ----------

// console 开关（出厂默认开；仅本地绑定）。
pub func console_on(root: i64) -> bool {
    return get_bool(root, "console.enabled", true)
}

// console 本地端口（出厂默认 7719；仅本地绑定）。
pub func console_port(root: i64) -> i64 {
    return get_int(root, "console.port", 7719)
}

// ---------- http（数据面限额；出厂默认见设计稿 §6 精神：可配、多数够用） ----------

// keep-alive 空闲回收毫秒（配置值为秒；0/负 = 不回收）。
pub func http_keepalive_ms(root: i64) -> i64 {
    var s = get_int(root, "http.keepalive_timeout", 60)
    if s <= 0 {
        return 0
    }
    return s * 1000
}

// 请求体上限（字节；超出 413）。
pub func http_max_body(root: i64) -> i64 {
    return get_int(root, "http.max_body", 1048576)
}

// 请求头/未解析缓冲上限（字节；超出 431）。
pub func http_max_header(root: i64) -> i64 {
    return get_int(root, "http.max_header", 16384)
}

// ---------- sites（虚拟主机；数组，每项表：host?/doc_root） ----------

// 站点数（无 sites 段 = 0）。
pub func site_count(root: i64) -> i64 {
    if root < 0 {
        return 0
    }
    var arr = tdcfg.path_get(root, "sites")
    if arr < 0 {
        return 0
    }
    return tdcfg.arr_len(arr)
}

// 站点 i 的 host 模式（空串 = 默认站点/未声明；支持 "*.后缀" 通配）。
pub func site_host(root: i64, i: i64) -> string {
    if root < 0 {
        return ""
    }
    var arr = tdcfg.path_get(root, "sites")
    if arr < 0 {
        return ""
    }
    var site = tdcfg.arr_at(arr, i)
    if site < 0 {
        return ""
    }
    var hn = tdcfg.map_get(site, "host")
    if hn < 0 {
        return ""
    }
    return tdcfg.str_val(hn)
}

// 站点 i 的文档根（缺失回落 dflt，通常传 server.doc_root）。
pub func site_doc_root(root: i64, i: i64, dflt: string) -> string {
    if root < 0 {
        return dflt
    }
    var arr = tdcfg.path_get(root, "sites")
    if arr < 0 {
        return dflt
    }
    var site = tdcfg.arr_at(arr, i)
    if site < 0 {
        return dflt
    }
    return get_str(site, "doc_root", dflt)
}

// 站点 i 的上游地址（"ip:port"；空串 = 静态站点）。
pub func site_upstream(root: i64, i: i64) -> string {
    if root < 0 {
        return ""
    }
    var arr = tdcfg.path_get(root, "sites")
    if arr < 0 {
        return ""
    }
    var site = tdcfg.arr_at(arr, i)
    if site < 0 {
        return ""
    }
    var un = tdcfg.map_get(site, "upstream")
    if un < 0 {
        return ""
    }
    return tdcfg.str_val(un)
}

// ---------- 启动摘要 ----------

// 配置摘要（启动打印；展示当前生效的关键项）。
pub func summary(root: i64) -> string {
    var s = ""
    s = s + "server.name    = " + get_str(root, "server.name", "leibnet") + "\n"
    s = s + "server.port    = " + to_string(get_int(root, "server.port", 8080)) + "\n"
    s = s + "server.workers = " + to_string(get_int(root, "server.workers", 0)) + "\n"
    var c = console_on(root)
    if c {
        s = s + "console.enabled = true\n"
        s = s + "console.port    = " + to_string(console_port(root)) + "\n"
    } else {
        s = s + "console.enabled = false\n"
    }
    s = s + "sites          = " + to_string(site_count(root)) + "\n"
    return s
}
}
